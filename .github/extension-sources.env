# Production backend images build these exact revisions against DUCKDB_VERSION.
# The Atlas extension repository is private, so GitHub Actions uses the
# read-only ATLAS_EXTENSION_DEPLOY_KEY configured on that repository.
ATLAS_EXTENSION_REPOSITORY=ekkuleivonen/atlas-duckdb-extension
ATLAS_EXTENSION_REF=dfe38364a19a689280111eba33b5e2b7abc158f7
DUCKLAKE_CDC_EXTENSION_REPOSITORY=ekkuleivonen/ducklake-cdc-extension
DUCKLAKE_CDC_EXTENSION_REF=9fec6a7decf417b1c5b68cbd0a51af187e4e2a99
DUCKDB_VERSION=v1.5.5
