# Production backend images build these exact revisions against DUCKDB_VERSION.
# The Periplus extension repository is private, so GitHub Actions uses the
# read-only PERIPLUS_EXTENSION_DEPLOY_KEY configured on that repository.
PERIPLUS_EXTENSION_REPOSITORY=ekkuleivonen/periplus-duckdb-extension
PERIPLUS_EXTENSION_REF=ca25dc7340e212249de97b31ebcaa4447c40d3a7
DUCKLAKE_CDC_EXTENSION_REPOSITORY=ekkuleivonen/ducklake-cdc-extension
DUCKLAKE_CDC_EXTENSION_REF=9fec6a7decf417b1c5b68cbd0a51af187e4e2a99
DUCKDB_VERSION=v1.5.5
