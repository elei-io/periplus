# Atlas development environment
#
# Copy this file to .env before running host-side commands. These credentials
# are intentionally local-only. Compose supplies container-network addresses
# separately from the host addresses below.

# Docker build inputs. Override these when the extension repositories live
# somewhere other than the default sibling checkouts.
ATLAS_DUCKDB_EXTENSION_REPO=../atlas-duckdb-extension
ATLAS_DUCKLAKE_CDC_EXTENSION_REPO=../quack/ducklake-cdc-extension-1.5.5
# ATLAS_BACKEND_IMAGE=atlas-backend:local
# ATLAS_WEB_IMAGE=atlas-web:local

# Published localhost ports.
ATLAS_API_PORT=8000
ATLAS_WEB_PORT=8080
ATLAS_POSTGRES_PORT=55432
LAKE_POSTGRES_PORT=55433
ATLAS_NATS_PORT=5422
ATLAS_NATS_MONITOR_PORT=5822
LAKE_S3_PORT=7070

# Atlas control Postgres. Compose maps the same identity to atlas-postgres.
ATLAS_POSTGRES_DATABASE=atlas
ATLAS_POSTGRES_USER=atlas
ATLAS_POSTGRES_PASSWORD=atlas_local
ATLAS_CONTROL_DATABASE_URL=postgresql://atlas:atlas_local@127.0.0.1:55432/atlas
ATLAS_CONTROL_POSTGRES_POOL_SIZE=8
ATLAS_CONTROL_POSTGRES_POOL_TIMEOUT_SECONDS=10

# DuckLake metadata Postgres. It never stores Atlas control tables.
LAKE_POSTGRES_DATABASE=lake
LAKE_POSTGRES_USER=lake
LAKE_POSTGRES_PASSWORD=lake_local

# Local Versity gateway. Root and client credentials are separate contracts
# even though the development values match.
LAKE_S3_ROOT_ACCESS_KEY=lake
LAKE_S3_ROOT_SECRET_ACCESS_KEY=lake-secret
ATLAS_DUCKLAKE_S3_KEY_ID=lake
ATLAS_DUCKLAKE_S3_SECRET_ACCESS_KEY=lake-secret

# Direct host-side DuckLake attachment.
ATLAS_DUCKLAKE_ALIAS=atlas
ATLAS_DUCKLAKE_METADATA_PATH=postgres:dbname=lake host=127.0.0.1 port=55433 user=lake password=lake_local
ATLAS_DUCKLAKE_METADATA_SCHEMA=ducklake
ATLAS_DUCKLAKE_DATA_PATH=s3://lake/
ATLAS_DUCKLAKE_S3_ENDPOINT=127.0.0.1:7070
ATLAS_DUCKLAKE_S3_REGION=us-east-1
ATLAS_DUCKLAKE_S3_URL_STYLE=path
ATLAS_DUCKLAKE_S3_USE_SSL=false
# ATLAS_DUCKLAKE_S3_SESSION_TOKEN=
# ATLAS_DUCKDB_EXTENSION_PATH=/absolute/path/to/atlas.duckdb_extension
# ATLAS_DUCKLAKE_CDC_EXTENSION_PATH=/absolute/path/to/ducklake_cdc.duckdb_extension
#
# For direct filesystem storage, replace ATLAS_DUCKLAKE_DATA_PATH with an
# absolute shared directory and remove the ATLAS_DUCKLAKE_S3_* variables.

# Atlas NATS and crawler acquisition endpoints.
ATLAS_NATS_URL=nats://127.0.0.1:5422
ATLAS_NATS_SEED=
ATLAS_CDP_URL=http://127.0.0.1:9222
ATLAS_COMPOSE_CDP_URL=http://host.docker.internal:9222

# Process-local concurrency. Scale replicas separately with Docker Compose.
ATLAS_INGESTOR_CONCURRENCY=4
ATLAS_MATERIALIZER_CONCURRENCY=2

# Atlas-owned immutable source-object repository. Compose uses a named volume.
ATLAS_REPOSITORY_STORAGE=disk
ATLAS_REPOSITORY_ROOT=.atlas/repository
# For an S3 repository instead:
# ATLAS_REPOSITORY_S3_BUCKET=atlas
# ATLAS_REPOSITORY_S3_ENDPOINT=http://127.0.0.1:9000
# ATLAS_REPOSITORY_S3_REGION=us-east-1
# ATLAS_REPOSITORY_S3_KEY_ID=atlas
# ATLAS_REPOSITORY_S3_SECRET_ACCESS_KEY=atlas-secret
# ATLAS_REPOSITORY_S3_SESSION_TOKEN=
# ATLAS_REPOSITORY_S3_URL_STYLE=path
# ATLAS_REPOSITORY_S3_USE_SSL=false

# Common operational policy overrides.
ATLAS_GRAPH_MAX_RUN_SECONDS=604800
ATLAS_GRAPH_RUN_RETENTION_SECONDS=2592000
ATLAS_SCHEDULE_POLL_SECONDS=5
ATLAS_SCHEDULE_MISFIRE_GRACE_SECONDS=60

# Optional catalogue assistant.
OPENAI_API_KEY=
ATLAS_AI_MODEL=openai:gpt-5.6-sol
ATLAS_AI_MODEL_TIMEOUT_SECONDS=180
ATLAS_AI_REQUEST_LIMIT=32
ATLAS_AI_TOOL_CALL_LIMIT=24
