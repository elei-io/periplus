# Periplus development environment
#
# Copy this file to .env before running host-side commands. These credentials
# are intentionally local-only. Compose supplies container-network addresses
# separately from the host addresses below.

# Docker build inputs. Override these when the extension repositories live
# somewhere other than the default sibling checkouts.
PERIPLUS_DUCKDB_EXTENSION_REPO=../periplus-duckdb-extension
PERIPLUS_DUCKLAKE_CDC_EXTENSION_REPO=../ducklake-cdc-extension
# PERIPLUS_CORE_IMAGE=periplus-core:local
# PERIPLUS_ADMIN_IMAGE=periplus-admin:local
# PERIPLUS_PUBLIC_IMAGE=periplus-public:local

# Published localhost ports.
PERIPLUS_API_PORT=8000
PERIPLUS_PUBLIC_PORT=8080
PERIPLUS_ADMIN_PORT=8081
PERIPLUS_POSTGRES_PORT=55432
LAKE_POSTGRES_PORT=55433
PERIPLUS_NATS_PORT=5422
PERIPLUS_NATS_MONITOR_PORT=5822
LAKE_ALLUXIO_S3_PORT=7070
LAKE_ALLUXIO_WORKER_CAPACITY=4GB
# LAKE_ALLUXIO_IMAGE=alluxio/alluxio:2.9.5

# Backblaze B2 is the durable Alluxio under-store. Create a bucket-scoped S3
# application key with read, write, list, and delete access. The application
# key is a secret and belongs only in the ignored .env file.
LAKE_B2_BUCKET=
# Optional. Leave empty when the bucket is dedicated to this development lake.
LAKE_B2_PREFIX=
LAKE_B2_ENDPOINT=
LAKE_B2_REGION=
LAKE_B2_KEY_ID=
LAKE_B2_APPLICATION_KEY=

# Periplus control Postgres. Compose maps the same identity to periplus-postgres.
PERIPLUS_POSTGRES_DATABASE=periplus
PERIPLUS_POSTGRES_USER=periplus
PERIPLUS_POSTGRES_PASSWORD=periplus_local
PERIPLUS_CONTROL_DATABASE_URL=postgresql://periplus:periplus_local@127.0.0.1:55432/periplus
PERIPLUS_CONTROL_POSTGRES_POOL_SIZE=8
PERIPLUS_CONTROL_POSTGRES_POOL_TIMEOUT_SECONDS=10

# DuckLake metadata Postgres. It never stores Periplus control tables.
LAKE_POSTGRES_DATABASE=lake
LAKE_POSTGRES_USER=lake
LAKE_POSTGRES_PASSWORD=lake_local

# Local Alluxio uses SIMPLE S3 authentication: the key ID is the Alluxio/Unix
# identity and the secret is a required but unvalidated client value.
PERIPLUS_DUCKLAKE_S3_KEY_ID=alluxio
PERIPLUS_DUCKLAKE_S3_SECRET_ACCESS_KEY=lake-secret

# Direct host-side DuckLake attachment.
PERIPLUS_DUCKLAKE_ALIAS=periplus
PERIPLUS_DUCKLAKE_METADATA_PATH=postgres:dbname=lake host=127.0.0.1 port=55433 user=lake password=lake_local
PERIPLUS_DUCKLAKE_METADATA_SCHEMA=ducklake
PERIPLUS_DUCKLAKE_DATA_PATH=s3://lake/
PERIPLUS_DUCKLAKE_S3_ENDPOINT=127.0.0.1:7070/api/v1/s3
PERIPLUS_DUCKLAKE_S3_REGION=us-east-1
PERIPLUS_DUCKLAKE_S3_URL_STYLE=path
PERIPLUS_DUCKLAKE_S3_USE_SSL=false
# PERIPLUS_DUCKLAKE_S3_SESSION_TOKEN=
# PERIPLUS_DUCKDB_EXTENSION_PATH=/absolute/path/to/periplus.duckdb_extension
# PERIPLUS_DUCKLAKE_CDC_EXTENSION_PATH=/absolute/path/to/ducklake_cdc.duckdb_extension
#
# For direct filesystem storage, replace PERIPLUS_DUCKLAKE_DATA_PATH with an
# absolute shared directory and remove the PERIPLUS_DUCKLAKE_S3_* variables.

# Periplus NATS and crawler acquisition endpoints.
PERIPLUS_NATS_URL=nats://127.0.0.1:5422
PERIPLUS_NATS_SEED=
PERIPLUS_CDP_URL=http://127.0.0.1:9222
PERIPLUS_COMPOSE_CDP_URL=http://host.docker.internal:9222

# Process-local concurrency. Scale replicas separately with Docker Compose.
PERIPLUS_INGESTOR_CONCURRENCY=4
PERIPLUS_MATERIALIZER_CONCURRENCY=2

# Periplus-owned immutable source objects use Alluxio's `raw` S3 namespace.
# Repository-relative keys begin with `html/` or `documents/`, producing B2
# paths under `raw/html/` and `raw/documents/`.
PERIPLUS_REPOSITORY_STORAGE=s3
PERIPLUS_REPOSITORY_S3_BUCKET=raw
PERIPLUS_REPOSITORY_S3_ENDPOINT=http://127.0.0.1:7070/api/v1/s3
PERIPLUS_COMPOSE_REPOSITORY_S3_ENDPOINT=http://lake-alluxio-s3:39999/api/v1/s3
PERIPLUS_REPOSITORY_S3_REGION=us-east-1
PERIPLUS_REPOSITORY_S3_KEY_ID=alluxio
PERIPLUS_REPOSITORY_S3_SECRET_ACCESS_KEY=lake-secret
PERIPLUS_REPOSITORY_S3_SESSION_TOKEN=
PERIPLUS_REPOSITORY_S3_URL_STYLE=path
PERIPLUS_REPOSITORY_S3_USE_SSL=false

# Common operational policy overrides.
PERIPLUS_GRAPH_MAX_RUN_SECONDS=604800
PERIPLUS_GRAPH_RUN_RETENTION_SECONDS=2592000
PERIPLUS_SCHEDULE_POLL_SECONDS=5
PERIPLUS_SCHEDULE_MISFIRE_GRACE_SECONDS=60

# Generate three distinct secrets with: openssl rand -hex 32
# Admin login: username admin, password PERIPLUS_ADMIN_API_TOKEN.
PERIPLUS_ADMIN_API_TOKEN=
PERIPLUS_PUBLIC_API_TOKEN=
PERIPLUS_PUBLIC_RECEIPT_SECRET=
