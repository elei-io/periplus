# Atlas has working localhost defaults. Copy this file to `.env` only for values
# you want to override. Runtime defaults and validation live in
# `backend/config/environment.py`.

# Local service locations, when they differ from the built-in defaults.
# DATABASE_URL=postgresql://atlas:atlas@127.0.0.1:5432/atlas
# ATLAS_CATALOGUE_CATALOG_DSN=host=127.0.0.1 port=5432 dbname=atlas_catalogue user=atlas password=atlas
# NATS_URL=nats://127.0.0.1:4222
# CDP_URL=http://127.0.0.1:9222
# ATLAS_WEB_PORT=8080
# Required when the API runs outside Compose. The URI must be reachable by the
# user's browser; non-local Quack endpoints should be exposed through TLS.
# ATLAS_QUACK_URI=quack:quack.example.internal:9494
# ATLAS_QUACK_TOKEN=replace-me
# Optional deployment-wide safety rails. Replica counts are the normal scaling
# control; the CDP service owns browser transport and capacity.
# ATLAS_GRAPH_MAX_REQUESTS_PER_RUN=10000
# ATLAS_GRAPH_MAX_RUN_SECONDS=3600
# ATLAS_SCHEDULE_POLL_SECONDS=5
# ATLAS_SCHEDULE_MISFIRE_GRACE_SECONDS=60
# ATLAS_CATALOGUE_MAX_CONCURRENCY=64
# ATLAS_OBJECT_IO_MAX_CONCURRENCY=64

# Compose owns its internal MinIO endpoint and S3 protocol settings. These are
# the only local object-store values intended for operator override.
# ATLAS_REPOSITORY_S3_BUCKET=atlas
# MINIO_ROOT_USER=atlas
# MINIO_ROOT_PASSWORD=atlas-secret
