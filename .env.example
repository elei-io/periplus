# Atlas has working localhost defaults. Copy this file to `.env` only for values
# you want to override. Runtime defaults and validation live in
# `backend/config/environment.py`.

# Local service locations, when they differ from the built-in defaults.
# DATABASE_URL=postgresql://atlas:atlas@127.0.0.1:5432/atlas
# ATLAS_CATALOGUE_CATALOG_DSN=host=127.0.0.1 port=5432 dbname=atlas_catalogue user=atlas password=atlas
# NATS_URL=nats://127.0.0.1:4222
# Deployment-only runaway protection for graph execution; these are not user graph settings.
# ATLAS_GRAPH_MAX_REQUESTS_PER_RUN=10000
# ATLAS_GRAPH_MAX_RUN_SECONDS=3600
# ATLAS_GRAPH_STREAM_REPLICAS=1
# ATLAS_GRAPH_ACK_WAIT_SECONDS=60
# ATLAS_GRAPH_STATE_MAX_BYTES=268435456
# Deployment-wide CrawlPolicy leases; heartbeat must remain shorter than the lease.
# ATLAS_CRAWL_POLICY_LEASE_SECONDS=120
# ATLAS_CRAWL_POLICY_HEARTBEAT_SECONDS=30
# ATLAS_NAVIGATION_MAX_PACKAGE_BYTES=16777216
# ATLAS_NAVIGATION_OBJECT_RETENTION_DAYS=2
# ATLAS_NAVIGATION_CLEANUP_GRACE_SECONDS=60
# ATLAS_EDGE_MAX_OUTPUT_ROWS=100000
# ATLAS_EDGE_MAX_OUTPUT_BYTES=16777216
# ATLAS_EDGE_QUERY_MEMORY_LIMIT=512MB
# ATLAS_EDGE_QUERY_TIMEOUT_SECONDS=30
# ATLAS_CATALOGUE_READ_POOL_SIZE=2
# ATLAS_CATALOGUE_READ_THREADS=2
# ATLAS_CATALOGUE_READ_POOL_WAIT_SECONDS=5
# ATLAS_CATALOG_OPERATION_LOCK_TIMEOUT_SECONDS=60
# Bound each embedded DuckDB/Postgres metadata pool. CDC uses non-blocking reads so
# an idle listener does not retain a PostgreSQL snapshot transaction.
# ATLAS_CATALOGUE_POSTGRES_POOL_MAX_CONNECTIONS=2
# ATLAS_CATALOGUE_POSTGRES_POOL_IDLE_TIMEOUT_MS=5000
# ATLAS_CATALOGUE_POSTGRES_POOL_MAX_LIFETIME_MS=60000
# ATLAS_CATALOGUE_POSTGRES_POOL_WAIT_TIMEOUT_MS=10000
# Flush a partially filled documents/crawls/elements batch when its oldest item reaches this age.
# ATLAS_INGEST_BATCH_WAIT_SECONDS=5
# ATLAS_INGEST_ACK_WAIT_SECONDS=60
# ATLAS_MATERIALIZATION_ACK_WAIT_SECONDS=60
# Disabled after reproducible Postgres-metadata inline-reader crashes under concurrent scans.
# ATLAS_CATALOGUE_DATA_INLINING_ROW_LIMIT=0

# Required only by CrawlPolicies whose profile is `firecrawl`.
# FIRECRAWL_API_KEY=fc-...

# Repository-worker small-file compaction. The worker checks between ingestion batches and
# compacts only when one table partition has at least this many files below the input-size limit.
# ATLAS_REPOSITORY_COMPACTION_ENABLED=true
# ATLAS_REPOSITORY_COMPACTION_INTERVAL_SECONDS=300
# ATLAS_REPOSITORY_COMPACTION_MIN_FILES=64
# ATLAS_REPOSITORY_COMPACTION_MAX_INPUT_FILE_BYTES=1048576
# ATLAS_REPOSITORY_COMPACTION_TARGET_FILE_BYTES=33554432
# ATLAS_REPOSITORY_COMPACTION_MAX_OUTPUT_FILES=4
# ATLAS_REPOSITORY_COMPACTION_MAX_OPERATION_BYTES=268435456
# Reclaim only files DuckLake scheduled for deletion, after this read-safety grace period.
# ATLAS_REPOSITORY_CLEANUP_OLD_FILES_SECONDS=604800
# Repository dead letters are retained for operator replay, but remain bounded.
# ATLAS_INGEST_DEAD_LETTER_TTL_SECONDS=2592000
# ATLAS_INGEST_DEAD_LETTER_MAX_BYTES=268435456

# Derived graph progress can be rebuilt from current run/request state.
# ATLAS_GRAPH_PROGRESS_TTL_SECONDS=2592000

# Incremental materialization. Scope results are bounded before Arrow staging;
# JetStream owns retries/dead letters and the repository worker remains the only writer.
# ATLAS_MATERIALIZATION_MAX_OUTPUT_ROWS=100000
# ATLAS_MATERIALIZATION_MAX_OUTPUT_BYTES=33554432
# Compatible materialization scopes flush at the first item, byte, or oldest-item deadline.
# ATLAS_MATERIALIZATION_COMMIT_BATCH_ITEMS=20
# ATLAS_MATERIALIZATION_COMMIT_BATCH_BYTES=134217728
# ATLAS_MATERIALIZATION_COMMIT_BATCH_WAIT_SECONDS=5
# ATLAS_MATERIALIZATION_BACKFILL_PAGE_SIZE=1000
# ATLAS_MATERIALIZATION_BACKFILL_SCOPES_PER_MINUTE=60
# ATLAS_MATERIALIZATION_STREAM_REPLICAS=1
# ATLAS_MATERIALIZATION_MAX_DELIVER=5
# ATLAS_MATERIALIZATION_MAX_LIVE_DEFINITIONS=32
# ATLAS_MATERIALIZATION_DEAD_LETTER_MAX_BYTES=268435456
# ATLAS_MATERIALIZATION_DEAD_LETTER_TTL_SECONDS=2592000
# ATLAS_DUCKLAKE_CDC_VERSION=ducklake_cdc 0.5.3
# ATLAS_DUCKLAKE_CDC_BUILD_REVISION=3d41ff7

# S3 repository used by the split Compose topology. Host-only tools may still use disk storage.
# ATLAS_REPOSITORY_STORAGE=s3
# ATLAS_REPOSITORY_S3_BUCKET=atlas
# ATLAS_REPOSITORY_S3_REGION=us-east-1
# ATLAS_REPOSITORY_S3_ENDPOINT=http://127.0.0.1:9000
# ATLAS_REPOSITORY_S3_KEY_ID=atlas
# ATLAS_REPOSITORY_S3_SECRET_ACCESS_KEY=atlas-secret
# ATLAS_REPOSITORY_S3_URL_STYLE=path
# ATLAS_REPOSITORY_S3_USE_SSL=false
