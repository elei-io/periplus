# Postgres used by local processes and Compose.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_PORT=5432
POSTGRES_CATALOGUE_DB=atlas_catalogue

# DuckLake metadata uses a separate Postgres database. This host DSN is for
# backend processes run outside Compose; Compose supplies its service-network DSN.
ATLAS_CATALOGUE_CATALOG=postgres
ATLAS_CATALOGUE_CATALOG_DSN=host=localhost port=5432 dbname=atlas_catalogue user=atlas password=atlas
ATLAS_CATALOGUE_ALIAS=atlas
ATLAS_CATALOGUE_SCHEMA=main
ATLAS_CATALOGUE_DATA_INLINING_ROW_LIMIT=0
# Disk paths differ between host and bind-mounted Compose processes. This option is
# safe only when those paths resolve to the same physical repository.
ATLAS_CATALOGUE_OVERRIDE_DATA_PATH=true
ATLAS_CATALOGUE_DUCKDB_DATABASE=:memory:
ATLAS_CATALOGUE_DUCKDB_THREADS=
ATLAS_CATALOGUE_DUCKDB_MEMORY_LIMIT=
ATLAS_CATALOGUE_DUCKDB_MAX_TEMP_SIZE=
ATLAS_CATALOGUE_DUCKDB_TEMP_DIRECTORY=

# One repository deployment controls both raw objects and DuckLake data.
# Raw objects use <prefix>/raw; DuckLake owns <prefix>/lake.
ATLAS_REPOSITORY_STORAGE=disk
ATLAS_REPOSITORY_ROOT=../.atlas/repository
ATLAS_REPOSITORY_S3_BUCKET=atlas
ATLAS_REPOSITORY_S3_PREFIX=
ATLAS_REPOSITORY_S3_ENDPOINT=
ATLAS_REPOSITORY_S3_REGION=
ATLAS_REPOSITORY_S3_KEY_ID=
ATLAS_REPOSITORY_S3_SECRET_ACCESS_KEY=
ATLAS_REPOSITORY_S3_SESSION_TOKEN=
ATLAS_REPOSITORY_S3_URL_STYLE=
ATLAS_REPOSITORY_S3_USE_SSL=
ATLAS_REPOSITORY_STAGING_ROOT=
# Hard per-document safety limits. Oversized captures fail explicitly.
ATLAS_REPOSITORY_MAX_HTML_BYTES=67108864
ATLAS_REPOSITORY_MAX_DOCUMENT_ELEMENTS=1000000
ATLAS_REPOSITORY_MAX_DOCUMENT_STAGED_BYTES=268435456

# Dedicated JetStream repository-ingestion worker.
ATLAS_INGEST_BATCH_ITEMS=100
ATLAS_INGEST_BATCH_ELEMENT_ROWS=250000
ATLAS_INGEST_BATCH_BYTES=268435456
ATLAS_INGEST_BATCH_WAIT_SECONDS=0.5
ATLAS_INGEST_ACK_WAIT_SECONDS=600
ATLAS_INGEST_MAX_ACK_PENDING=1000
ATLAS_INGEST_MAX_DELIVER=5
ATLAS_INGEST_STREAM_REPLICAS=1
# Must remain below the deployment's NATS max_payload.
ATLAS_NATS_MAX_ENVELOPE_BYTES=921600
# Producers persist pending state before publish, record PubAck with KV CAS, and
# poll durable terminal state. Unconfirmed publication is safely resumed.
ATLAS_INGEST_RESULT_POLL_SECONDS=0.5
ATLAS_INGEST_RESULT_TTL_SECONDS=604800
ATLAS_INGEST_RESULT_MAX_BYTES=268435456
ATLAS_INGEST_RESULT_REPLICAS=1
ATLAS_INGEST_STAGING_CLEANUP_INTERVAL_SECONDS=900
ATLAS_INGEST_STAGING_GRACE_SECONDS=3600

# Standard AWS variables are credential/region fallbacks for repository-specific values.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Acquisition cache freshness. Retention is configured independently.
ATLAS_CACHE_MAX_AGE_SECONDS=120
# Optional total maximum age for stale fallback after network failure.
ATLAS_CACHE_STALE_IF_ERROR_SECONDS=

# Compose MinIO development credentials.
MINIO_ROOT_USER=atlas
MINIO_ROOT_PASSWORD=atlas-secret

# Worker scheduling, task slots, leases, and shutdown.
# Total task capacity is worker replicas × ATLAS_WORKER_CONCURRENCY.
ATLAS_WORKER_CONCURRENCY=4
ATLAS_WORKER_POLL_SECONDS=5
ATLAS_TASK_RUN_TIMEOUT_SECONDS=1800
ATLAS_TASK_RESULT_MAX_BYTES=5242880
ATLAS_SCHEDULER_BATCH_SIZE=20
# Leave empty to use hostname:pid.
ATLAS_WORKER_ID=
ATLAS_TASK_STREAM_REPLICAS=1
ATLAS_TASK_ACK_WAIT_SECONDS=60
ATLAS_TASK_RUN_STATE_MAX_BYTES=268435456
ATLAS_WORKER_PRESENCE_TTL_SECONDS=30

# Each task run uses a bounded page queue. With isolated run subprocesses, the
# maximum browsers opened by one worker is worker concurrency × per-run concurrency.
ATLAS_CRAWL_CONCURRENCY_PER_RUN=3
# Deployment-wide browser capacity. Matching crawl-policy max_concurrency values
# add stricter per-policy caps across every worker replica.
ATLAS_BROWSER_CONCURRENCY=12
ATLAS_CRAWL_PERMIT_TIMEOUT_SECONDS=120

# Index traversal is an in-memory breadth-first walk with explicit page and link limits.
ATLAS_INDEX_PAGE_BATCH_SIZE=32

# Worker logging: text or json; DEBUG, INFO, WARNING, ERROR, or CRITICAL.
ATLAS_LOG_FORMAT=text
ATLAS_LOG_LEVEL=INFO

# Worker Prometheus endpoint and optional API-side Prometheus enrichment.
ATLAS_METRICS_ENABLED=true
ATLAS_METRICS_HOST=0.0.0.0
ATLAS_METRICS_PORT=9090
ATLAS_INGESTOR_METRICS_PORT=9091
ATLAS_INGESTOR_HEALTH_HOST=0.0.0.0
ATLAS_INGESTOR_HEALTH_PORT=9092
ATLAS_INGESTOR_HEALTH_HEARTBEAT_TIMEOUT_SECONDS=5
ATLAS_INGESTOR_HEALTH_PROBE_INTERVAL_SECONDS=10
ATLAS_INGESTOR_HEALTH_PROBE_TIMEOUT_SECONDS=2
ATLAS_PROMETHEUS_URL=

# One-time acknowledgement for upgrading a populated pre-DuckLake installation.
# Leave unset for clean installs. Back up/export Postgres before enabling it.
ATLAS_ALLOW_LEGACY_STORAGE_DROP=

# Ephemeral progress delivery. Postgres remains authoritative for runs/results.
NATS_URL=nats://localhost:4222
NATS_RETENTION=5m

# Action behavior.
MAX_EXTRACT_ATTEMPTS=2

# Optional: needed for schema generation, query-parameter generation, and LLM extraction.
OPENROUTER_API_KEY=
LLM_PROVIDER=openai/gpt-5.5
OPENROUTER_SCHEMA_MODEL=openai/gpt-5.5
OPENROUTER_SEARCH_EXTRACTOR_MODEL=openai/gpt-5.5
OPENROUTER_QUERY_PARAM_MODEL=openai/gpt-5.5

# Optional CLI override. Normally configured through `atlas init --url ...`.
ATLAS_API_URL=

# Optional: enables the destructive/transactional Postgres integration test suite.
# Use a dedicated test database.
ATLAS_TEST_DATABASE_URL=
