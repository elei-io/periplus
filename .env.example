# Periplus development environment
#
# Copy this file to .env before running host-side commands. These credentials
# are intentionally local-only. Compose supplies container-network addresses
# separately from the host addresses below.

# Optional local Docker image names. No sibling extension checkout is required.
# PERIPLUS_CORE_IMAGE=periplus-core:local
# PERIPLUS_ADMIN_IMAGE=periplus-admin:local
# PERIPLUS_PUBLIC_IMAGE=periplus-public:local
# Public SEO build input. Leave empty locally (noindex); set the real HTTPS origin
# when building an indexable production image. Runtime env cannot change static SEO.
PERIPLUS_PUBLIC_ORIGIN=

# Published localhost ports.
PERIPLUS_API_PORT=8000
PERIPLUS_PUBLIC_PORT=8080
PERIPLUS_ADMIN_PORT=8081
PERIPLUS_POSTGRES_PORT=55432
LAKE_POSTGRES_PORT=55433
PERIPLUS_NATS_PORT=5422
PERIPLUS_NATS_MONITOR_PORT=5822
LAKE_S3_PORT=7070
# LAKE_S3_IMAGE=versity/versitygw:v1.8.0
# Local Versity root credentials, shared by Compose writers. Host-side client
# credentials below must match if these are changed. Never expose this writer
# identity to public clients.
LAKE_S3_KEY_ID=periplus-local
LAKE_S3_SECRET_ACCESS_KEY=lake-secret

# Periplus control Postgres. Compose maps the same identity to periplus-postgres.
PERIPLUS_POSTGRES_DATABASE=periplus
PERIPLUS_POSTGRES_USER=periplus
PERIPLUS_POSTGRES_PASSWORD=periplus_local
PERIPLUS_CONTROL_DATABASE_URL=postgresql://periplus:periplus_local@127.0.0.1:55432/periplus
PERIPLUS_CONTROL_POSTGRES_POOL_SIZE=8
PERIPLUS_CONTROL_POSTGRES_POOL_TIMEOUT_SECONDS=10

# DuckLake metadata Postgres. It never stores Periplus control tables.
LAKE_POSTGRES_DATABASE=lake
LAKE_POSTGRES_USER=lake
LAKE_POSTGRES_PASSWORD=lake_local

# Host-side credentials for the local S3 service.
PERIPLUS_DUCKLAKE_S3_KEY_ID=periplus-local
PERIPLUS_DUCKLAKE_S3_SECRET_ACCESS_KEY=lake-secret

# Direct host-side DuckLake attachment.
PERIPLUS_DUCKLAKE_ALIAS=periplus
PERIPLUS_DUCKLAKE_METADATA_PATH=postgres:dbname=lake host=127.0.0.1 port=55433 user=lake password=lake_local
PERIPLUS_DUCKLAKE_METADATA_SCHEMA=ducklake
PERIPLUS_DUCKLAKE_DATA_PATH=s3://lake/
PERIPLUS_DUCKLAKE_S3_ENDPOINT=127.0.0.1:7070
PERIPLUS_DUCKLAKE_S3_REGION=us-east-1
PERIPLUS_DUCKLAKE_S3_URL_STYLE=path
PERIPLUS_DUCKLAKE_S3_USE_SSL=false
# PERIPLUS_DUCKLAKE_S3_SESSION_TOKEN=
#
# For direct filesystem storage, replace PERIPLUS_DUCKLAKE_DATA_PATH with an
# absolute shared directory and remove the PERIPLUS_DUCKLAKE_S3_* variables.

# Periplus NATS and crawler acquisition endpoints.
PERIPLUS_NATS_URL=nats://127.0.0.1:5422
PERIPLUS_NATS_SEED=
PERIPLUS_CDP_URL=http://127.0.0.1:9222
PERIPLUS_COMPOSE_CDP_URL=http://host.docker.internal:9222

# Process-local concurrency. Scale replicas separately with Docker Compose.
PERIPLUS_INGESTOR_CONCURRENCY=4
PERIPLUS_MATERIALIZER_CONCURRENCY=2

# Periplus-owned immutable source objects use the local `raw` S3 bucket.
# Repository-relative keys begin with `html/` or `documents/`.
PERIPLUS_REPOSITORY_STORAGE=s3
PERIPLUS_REPOSITORY_S3_BUCKET=raw
PERIPLUS_REPOSITORY_S3_ENDPOINT=http://127.0.0.1:7070
PERIPLUS_REPOSITORY_S3_REGION=us-east-1
PERIPLUS_REPOSITORY_S3_KEY_ID=periplus-local
PERIPLUS_REPOSITORY_S3_SECRET_ACCESS_KEY=lake-secret
PERIPLUS_REPOSITORY_S3_SESSION_TOKEN=
PERIPLUS_REPOSITORY_S3_URL_STYLE=path
PERIPLUS_REPOSITORY_S3_USE_SSL=false


# Generate three distinct secrets with: openssl rand -hex 32
# Server-side admin API credential; production admin access is enforced by Cloudflare Access.
PERIPLUS_ADMIN_API_TOKEN=
PERIPLUS_PUBLIC_API_TOKEN=

# Dedicated query service. Only the query process receives these reader identities.
PERIPLUS_QUERY_PORT=8010
PERIPLUS_API_URL=http://127.0.0.1:8000
PERIPLUS_QUERY_URL=http://127.0.0.1:8010

# Query history identifies the deployed version; leave unset if unknown locally.
PERIPLUS_SERVICE_VERSION=
PERIPLUS_QUERY_API_TOKEN=
LAKE_QUERY_USER=lake_query
LAKE_QUERY_PASSWORD=lake_query_local
LAKE_QUERY_S3_KEY_ID=periplus-query
LAKE_QUERY_S3_SECRET_ACCESS_KEY=query-local-secret

# Public web discovery agent (server-side only; optional)
OPENAI_API_KEY=
PERIPLUS_AI_MODEL=

# Crawler collection source discovery (model must support structured outputs).
BRAVE_SEARCH_API_KEY=
PERIPLUS_DISCOVERY_MODEL=

# Retention: request intent defaults to forever. Purge is destructive and opt-in.
# See docs/RETENTION.md; dry_run reports candidates without changing retained data.
PERIPLUS_RETENTION_MODE=disabled
PERIPLUS_RETENTION_BATCH_SIZE=25
PERIPLUS_RETENTION_MINIMUM_AGE_SECONDS=86400
PERIPLUS_RETENTION_OBJECT_GRACE_SECONDS=86400

# Optional per-process DuckDB sizing overrides. Helm sets these separately by role.
# Budgets apply to EACH connection, including materializer coordination clients.
# Unset values retain workload defaults; 0B disables spill.
# PERIPLUS_DUCKDB_THREADS=2
# PERIPLUS_DUCKDB_MEMORY_LIMIT=512MB
# PERIPLUS_DUCKDB_MAX_TEMP_DIRECTORY_SIZE=256MB

# Capture delivery, presence, pacing and operation leases; use 3 on a three-server cluster.
PERIPLUS_NATS_OPERATIONAL_REPLICAS=1
