# NATS queue used by async index jobs.
NATS_URL=nats://localhost:4222

# Scrape cache settings.
CACHE_ROOT=.cache
CACHE_CLEANUP_INTERVAL=3600
CACHE_TTL_SECONDS=86400

# Optional: only needed when generating extraction schemas or target JSON examples.
OPENROUTER_API_KEY=
OPENROUTER_SCHEMA_MODEL=openai/gpt-4o
OPENROUTER_SEARCH_EXTRACTOR_MODEL=openai/gpt-4o
