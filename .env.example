# Postgres used by local Compose services.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_PORT=5432

# Ephemeral local artifacts for task runs.
ARTIFACTS_ROOT=.artifacts
ARTIFACTS_CLEANUP_INTERVAL=3600
ARTIFACTS_TTL_SECONDS=86400

# Optional: only needed when generating extraction schemas or target JSON examples.
OPENROUTER_API_KEY=
OPENROUTER_SCHEMA_MODEL=openai/gpt-4o
OPENROUTER_SEARCH_EXTRACTOR_MODEL=openai/gpt-4o
