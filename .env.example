# Docker Compose provides local Postgres, DuckLake files, immutable objects,
# and JetStream. Only the standard CDP endpoint remains external.

# Local state endpoints exposed to host-side tools:
# atlas_test Postgres: postgresql://atlas:atlas_local@127.0.0.1:55432/atlas_test
# atlas_test NATS: nats://127.0.0.1:5422
# DuckLake files (S3): http://127.0.0.1:7070, bucket atlas
# ATLAS_POSTGRES_POOL_SIZE=4
# ATLAS_POSTGRES_POOL_TIMEOUT_SECONDS=5
# CDP_URL=http://127.0.0.1:9222
# ATLAS_WEB_PORT=8080
# ATLAS_DUCKLAKE_S3_PORT=7070
# ATLAS_DUCKLAKE_S3_KEY_ID=atlas
# ATLAS_DUCKLAKE_S3_SECRET_ACCESS_KEY=atlas-secret
# Optional deployment-wide safety rails. Bounded local worker concurrency is
# the normal catalogue control; add replicas after local saturation.
# ATLAS_INGESTION_CONCURRENCY=4
# ATLAS_MATERIALIZATION_CONCURRENCY=2
# The CDP service owns browser transport and capacity.
# ATLAS_GRAPH_MAX_RUN_SECONDS=604800
# ATLAS_GRAPH_RUN_RETENTION_SECONDS=2592000
# ATLAS_SCHEDULE_POLL_SECONDS=5
# ATLAS_SCHEDULE_MISFIRE_GRACE_SECONDS=60

# Atlas-owned immutable raw-object storage.
# ATLAS_REPOSITORY_S3_BUCKET=atlas
# ATLAS_REPOSITORY_S3_ENDPOINT=http://127.0.0.1:9000
# ATLAS_REPOSITORY_S3_REGION=us-east-1
# ATLAS_REPOSITORY_S3_KEY_ID=atlas
# ATLAS_REPOSITORY_S3_SECRET_ACCESS_KEY=atlas-secret
# ATLAS_REPOSITORY_S3_URL_STYLE=path
# ATLAS_REPOSITORY_S3_USE_SSL=false
# Direct Atlas DuckLake attachment. Compose supplies these values internally;
# set them for host-side processes or non-Compose deployments.
# ATLAS_DUCKLAKE_ALIAS=atlas
# ATLAS_DUCKLAKE_METADATA_PATH=postgres:dbname=atlas_test host=127.0.0.1 port=55432 user=atlas password=atlas_local
# ATLAS_DUCKLAKE_METADATA_SCHEMA=ducklake
# ATLAS_DUCKLAKE_DATA_PATH=s3://atlas/
# ATLAS_DUCKLAKE_S3_ENDPOINT=127.0.0.1:7070
# ATLAS_DUCKLAKE_S3_REGION=us-east-1
# ATLAS_DUCKLAKE_S3_URL_STYLE=path
# ATLAS_DUCKLAKE_S3_USE_SSL=false
# For direct filesystem storage instead, set:
# ATLAS_DUCKLAKE_DATA_PATH=/absolute/shared/path/to/lake/
# ATLAS_DUCKDB_EXTENSION_PATH=/absolute/path/to/atlas.duckdb_extension
# ATLAS_DUCKLAKE_CDC_EXTENSION_PATH=/absolute/path/to/ducklake_cdc.duckdb_extension

# Request-scoped SQL console assistant.
# OPENAI_API_KEY=...
# ATLAS_AI_MODEL=openai:gpt-5.6-sol
# ATLAS_AI_MODEL_TIMEOUT_SECONDS=180
# ATLAS_AI_REQUEST_LIMIT=32
# ATLAS_AI_TOOL_CALL_LIMIT=24
