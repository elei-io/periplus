# Postgres used by local processes and Compose.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_PORT=5432

# Ephemeral task-run artifacts and cleanup.
ARTIFACTS_ROOT=.artifacts
ARTIFACTS_CLEANUP_INTERVAL_SECONDS=60
ARTIFACTS_CLEANUP_BATCH_SIZE=100
ARTIFACT_CACHE_AGE_SECONDS=120

# Worker scheduling, task slots, leases, and shutdown.
# Total task capacity is worker replicas × ATLAS_WORKER_CONCURRENCY.
ATLAS_WORKER_CONCURRENCY=4
ATLAS_WORKER_POLL_SECONDS=5
ATLAS_WORKER_HEARTBEAT_SECONDS=10
ATLAS_WORKER_LEASE_SECONDS=45
ATLAS_TASK_RUN_TIMEOUT_SECONDS=1800
ATLAS_WORKER_SHUTDOWN_GRACE_SECONDS=30
ATLAS_SCHEDULER_BATCH_SIZE=20
# Leave empty to use hostname:pid.
ATLAS_WORKER_ID=

# Each task run uses a bounded page queue. With isolated run subprocesses, the
# maximum browsers opened by one worker is worker concurrency × per-run concurrency.
ATLAS_CRAWL_CONCURRENCY_PER_RUN=3
# Deployment-wide browser capacity. Matching crawl-policy max_concurrency values
# add stricter per-policy caps across every worker replica.
ATLAS_BROWSER_CONCURRENCY=12
ATLAS_CRAWL_PERMIT_LEASE_SECONDS=60
ATLAS_CRAWL_PERMIT_TIMEOUT_SECONDS=120

# Worker logging: text or json; DEBUG, INFO, WARNING, ERROR, or CRITICAL.
ATLAS_LOG_FORMAT=text
ATLAS_LOG_LEVEL=INFO

# Ephemeral progress delivery. Postgres remains authoritative for runs/results.
NATS_URL=nats://localhost:4222
NATS_RETENTION=5m

# Action behavior.
MAX_EXTRACT_ATTEMPTS=2

# Optional: needed for schema generation, query-parameter generation, and LLM extraction.
OPENROUTER_API_KEY=
LLM_PROVIDER=openai/gpt-5.5
OPENROUTER_SCHEMA_MODEL=openai/gpt-5.5
OPENROUTER_SEARCH_EXTRACTOR_MODEL=openai/gpt-5.5
OPENROUTER_QUERY_PARAM_MODEL=openai/gpt-5.5

# Optional CLI override. Normally configured through `atlas init --url ...`.
ATLAS_API_URL=

# Optional: enables the destructive/transactional Postgres integration test suite.
# Use a dedicated test database.
ATLAS_TEST_DATABASE_URL=
