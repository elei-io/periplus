# Atlas has working localhost defaults. Copy this file to `.env` only for values
# you want to override. Runtime defaults and validation live in
# `backend/config/environment.py`.

# Local service locations, when they differ from the built-in defaults.
# DATABASE_URL=postgresql://atlas:atlas@127.0.0.1:5432/atlas
# ATLAS_CATALOGUE_CATALOG_DSN=host=127.0.0.1 port=5432 dbname=atlas_catalogue user=atlas password=atlas
# NATS_URL=nats://127.0.0.1:4222
# NATS_SEED=SU...
# CDP_URL=http://127.0.0.1:9222
# ATLAS_WEB_PORT=8080
# Required when the API runs outside Compose. Quack is private infrastructure:
# only Atlas API compute needs network access to this endpoint.
# ATLAS_QUACK_URI=quack:quack.example.internal:9494
# ATLAS_QUACK_TOKEN=replace-me
# ATLAS_QUACK_DISABLE_SSL=false
# ATLAS_QUACK_MAX_CONCURRENCY=4
# ATLAS_QUACK_POOL_WAIT_SECONDS=5
# ATLAS_QUACK_QUERY_TIMEOUT_SECONDS=30
# ATLAS_QUACK_QUERY_MAX_ROWS=100000
# ATLAS_QUACK_QUERY_MAX_BYTES=67108864
# ATLAS_QUACK_QUERY_STATE_TTL_SECONDS=3600
# ATLAS_QUACK_QUERY_STATE_MAX_BYTES=67108864

# Required for the agentic home-page catalogue search.
# OPENAI_API_KEY=sk-...
# ATLAS_SEARCH_MODEL=openai:gpt-5.6-luna
# ATLAS_SEARCH_MODEL_TIMEOUT_SECONDS=60
# ATLAS_SEARCH_MODEL_REQUEST_LIMIT=32
# ATLAS_SEARCH_TOOL_CALL_LIMIT=24
# Optional. Enables ephemeral start-URL discovery for acquisition plans.
# BRAVE_SEARCH_API_KEY=replace-me
# Optional deployment-wide safety rails. Replica counts are the normal scaling
# control; the CDP service owns browser transport and capacity.
# ATLAS_GRAPH_MAX_REQUESTS_PER_RUN=10000
# ATLAS_GRAPH_MAX_RUN_SECONDS=3600
# ATLAS_SCHEDULE_POLL_SECONDS=5
# ATLAS_SCHEDULE_MISFIRE_GRACE_SECONDS=60
# ATLAS_CATALOGUE_MAX_CONCURRENCY=64
# ATLAS_OBJECT_IO_MAX_CONCURRENCY=64

# Local object-store defaults. External deployments may override the endpoint,
# credentials, URL style, and TLS behavior directly.
# ATLAS_REPOSITORY_S3_BUCKET=atlas
# ATLAS_REPOSITORY_S3_ENDPOINT=http://127.0.0.1:9000
# ATLAS_REPOSITORY_S3_REGION=us-east-1
# ATLAS_REPOSITORY_S3_KEY_ID=atlas
# ATLAS_REPOSITORY_S3_SECRET_ACCESS_KEY=atlas-secret
# ATLAS_REPOSITORY_S3_URL_STYLE=path
# ATLAS_REPOSITORY_S3_USE_SSL=false
# MINIO_ROOT_USER=atlas
# MINIO_ROOT_PASSWORD=atlas-secret
