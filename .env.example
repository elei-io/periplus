# Docker Compose provides isolated local Postgres and Atlas NATS state for
# atlas_test and atlas_load. The Atlas application services are deliberately
# hard-wired to atlas_test; local Compose never reads production DATABASE_URL
# or ATLAS_NATS_* credentials. DuckBasin, Basin NATS, object storage, and CDP
# remain external.

# Local state endpoints exposed to host-side tools:
# atlas_test Postgres: postgresql://atlas:atlas_local@127.0.0.1:55432/atlas_test
# atlas_load Postgres: postgresql://atlas:atlas_local@127.0.0.1:55433/atlas_load
# atlas_test NATS: nats://127.0.0.1:5422
# atlas_load NATS: nats://127.0.0.1:5423
# ATLAS_POSTGRES_POOL_SIZE=4
# ATLAS_POSTGRES_POOL_TIMEOUT_SECONDS=5
# CDP_URL=http://127.0.0.1:9222
# ATLAS_WEB_PORT=8080
# Interactive query limits apply to Basin-minted Quack sessions.
# ATLAS_QUACK_MAX_CONCURRENCY=4
# ATLAS_QUACK_POOL_WAIT_SECONDS=5
# ATLAS_QUACK_QUERY_TIMEOUT_SECONDS=30
# ATLAS_QUACK_QUERY_MAX_ROWS=100000
# ATLAS_QUACK_QUERY_MAX_BYTES=67108864
# ATLAS_QUACK_QUERY_STATE_TTL_SECONDS=3600
# ATLAS_QUACK_QUERY_STATE_MAX_BYTES=67108864

# Required for the session-local console catalogue assistant.
# OPENAI_API_KEY=sk-...
# ATLAS_AI_MODEL=openai:gpt-5.6-luna
# ATLAS_AI_MODEL_TIMEOUT_SECONDS=180
# ATLAS_AI_REQUEST_LIMIT=32
# ATLAS_AI_TOOL_CALL_LIMIT=24
# Optional deployment-wide safety rails. Bounded managed-client lanes are the
# normal catalogue concurrency control; add replicas after local saturation.
# The CDP service owns browser transport and capacity.
# ATLAS_GRAPH_MAX_RUN_SECONDS=604800
# ATLAS_GRAPH_RUN_RETENTION_SECONDS=2592000
# ATLAS_SCHEDULE_POLL_SECONDS=5
# ATLAS_SCHEDULE_MISFIRE_GRACE_SECONDS=60

# Atlas-owned immutable raw-object storage.
# ATLAS_REPOSITORY_S3_BUCKET=atlas
# ATLAS_REPOSITORY_S3_ENDPOINT=http://127.0.0.1:9000
# ATLAS_REPOSITORY_S3_REGION=us-east-1
# ATLAS_REPOSITORY_S3_KEY_ID=atlas
# ATLAS_REPOSITORY_S3_SECRET_ACCESS_KEY=atlas-secret
# ATLAS_REPOSITORY_S3_URL_STYLE=path
# ATLAS_REPOSITORY_S3_USE_SSL=false
# DuckBasin managed lake and OAuth client credentials. Quack targets and
# session-affine routing are discovered by the client minter.
# DUCKBASIN_URL=...
# DUCKBASIN_LAKE=...
# DUCKBASIN_TOKEN_ENDPOINT=...
# DUCKBASIN_CLIENT_ID=...
# DUCKBASIN_CLIENT_SECRET=...

# Basin-owned CDC namespace. Only the catalogue ingress consumes it.
# DUCKBASIN_NATS_SEED=xxx
# DUCKBASIN_NATS_URL=nats://nats.elei.io:4222
